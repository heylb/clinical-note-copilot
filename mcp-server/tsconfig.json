{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "rootDir": "..",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "declaration": false,
    "sourceMap": true,
    "lib": ["ES2022"]
  },
  "include": [
    "src/**/*",
    "../lib/schemas.ts",
    "../lib/prompts/extractSOAP.ts",
    "../lib/prompts/suggestICD.ts",
    "../lib/prompts/redactPHI.ts",
    "../lib/pii/regex.ts"
  ]
}
